select from llm
where factId = 'Inventory:INV-001'
and relatedFactIds = 'Sales,Vendor,Product,Location'
expression = '(Inventory.quantityOnHand - Inventory.quantityReserved) / Sales.quantitySold'
definition = 'Definitions: success = return means available, fail = return means unavailable. Resolution: if available, result = success; if unavailable, result = fail.'
