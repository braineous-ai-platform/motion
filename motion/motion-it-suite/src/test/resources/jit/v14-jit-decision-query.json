select from llm
where factId = 'Inventory:INV-001'
and relatedFactIds = 'Sales:SALE-001,Vendor:VENDOR-001,Product:PROD-SHAMPOO-250,Location:LOC-001'
control
parameters = 'Inventory.quantityOnHand, Inventory.quantityReserved, Sales.quantitySold, Vendor.leadTimeDays'
expression = 'return = (Inventory.quantityOnHand - Inventory.quantityReserved) / Sales.quantitySold'
spec = 'Definitions: success = return means available, fail = return means unavailable. Resolution: if available, result = success; if unavailable, result = fail.'
result=""